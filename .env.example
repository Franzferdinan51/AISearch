# Lumen local orchestration API
LUMEN_API_HOST=127.0.0.1
LUMEN_API_PORT=8787

# SearXNG must expose /search?format=json
SEARXNG_URL=http://127.0.0.1:8080

# Optional OpenAI-compatible model runtimes. Keep these server-side.
LM_STUDIO_URL=http://127.0.0.1:1234/v1
LM_STUDIO_MODEL=local-model
LM_API_TOKEN=
# Local models can take longer on slower hardware. Default: 180000 (3 min);
# accepted range: 30000-600000 milliseconds.
LM_STUDIO_TIMEOUT_MS=180000
# Runtime controls can also be set per model in Providers. Lumen queues local
# completions and safely retries retryable failures with a reduced budget.
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-5
OPENAI_API_KEY=
MINIMAX_BASE_URL=https://api.minimax.io/v1
MINIMAX_MODEL=MiniMax-M2.7
MINIMAX_API_KEY=
XAI_BASE_URL=https://api.x.ai/v1
XAI_MODEL=grok-4.5
XAI_API_KEY=

# OAuth-capable local CLIs, following the Prediction pattern.
OPENAI_CODEX_COMMAND=codex
# Optional Codex model override for environments with a compatible OAuth model.
OPENAI_CODEX_MODEL=
MINIMAX_CLI_COMMAND=mmx
GROK_BUILD_COMMAND=grok
